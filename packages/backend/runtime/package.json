{
  "name": "@aura/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "aura": {
    "kind": "library",
    "layer": "backend"
  },
  "exports": {
    ".": "./src/index.ts",
    "./site": "./src/site-runner.ts",
    "./validation": "./src/validation.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aura/extensions": "workspace:*",
    "@aura/orchestration": "workspace:*",
    "@aura/dsh-auth": "workspace:*",
    "@aura/demo": "workspace:*",
    "@aura/plugin-sdk": "workspace:*",
    "@aura/protocol": "workspace:*",
    "@aura/tripo": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@deepseek-ai/dsh": "0.1.5-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.3",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.3",
    "hono": "4.13.7",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "~5.9.2"
  }
}
