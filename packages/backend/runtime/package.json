  "dependencies": {
    "@aura/dsh-codex": "workspace:*",
    "@aura/demo": "workspace:*",
    "@aura/protocol": "workspace:*",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-rc.1"
  }
}
