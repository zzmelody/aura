{
  "name": "@aura/orchestration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "aura": {
    "kind": "library",
    "layer": "backend"
  },
  "exports": {
    ".": "./src/index.ts",
    "./flow": {
      "types": "./types/flow.d.ts",
      "default": "./src/flow-api.ts"
    },
    "./action": {
      "types": "./types/action.d.ts",
      "default": "./src/action-api.ts"
    },
    "./capability": {
      "types": "./types/capability.d.ts",
      "default": "./src/capability-api.ts"
    },
    "./local-ai": "./src/local-ai/api.ts",
    "./short-video": "./src/short-video.ts",
    "./video-production": "./src/video-production.ts",
    "./content-production": "./src/content-production.ts",
    "./content-review": "./src/content-review.ts",
    "./topic-production": "./src/topic-production.ts",
    "./plugin": "./src/plugin.ts",
    "./demo": "./src/demo.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aura/content-research": "workspace:*",
    "@aura/dsh-auth": "workspace:*",
    "@aura/protocol": "workspace:*",
    "@aura/tripo": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.3",
    "@deepseek-ai/dsh-base": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-file-upload": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-persona": "0.1.5-rc.3",
    "@deepseek-ai/dsh-sdk-app": "0.1.5-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.3",
    "@deepseek-ai/dsh-win32-process": "0.1.5-rc.3",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.3",
    "acorn": "8.18.0",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "hono": "4.13.7",
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "zod": "^4.3.6",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.3"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "~5.9.2"
  }
}
