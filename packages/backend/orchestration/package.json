{
  "name": "@aura/orchestration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "aura": {
    "kind": "library",
    "layer": "backend"
  },
  "exports": {
    ".": "./src/index.ts",
    "./flow": {
      "types": "./types/flow.d.ts",
      "default": "./src/flow-api.ts"
    },
    "./action": {
      "types": "./types/action.d.ts",
      "default": "./src/action-api.ts"
    },
    "./demo": "./src/demo.ts",
    "./backend": "./src/backend-api.ts",
    "./plugin-media": "./src/plugin-media-api.ts",
    "./plugin-storage": "./src/plugin-storage-api.ts",
    "./plugin-errors": "./src/plugin-errors.ts",
    "./host": "./src/host.ts",
    "./service": "./src/workflow-service.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aura/dsh-auth": "workspace:*",
    "@aura/protocol": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.5",
    "@deepseek-ai/dsh-win32-process": "0.2.1-rc.5",
    "acorn": "8.18.0",
    "ffmpeg-static": "5.3.0",
    "hono": "4.13.7",
    "sharp": "0.35.4",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-web-deepseek-api": "0.2.1-rc.5",
    "@hono/node-server": "2.1.1",
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "~5.9.2"
  }
}
