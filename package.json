{
  "name": "aura-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/frontend/*",
    "packages/backend/*",
    "packages/shared/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "tsx scripts/run-with-runtime.ts web",
    "web": "pnpm --filter @aura/web run dev",
    "mobile": "pnpm --filter @aura/mobile run dev",
    "mobile:sync": "pnpm --filter @aura/mobile run sync",
    "desktop": "pnpm --filter @aura/desktop run dev",
    "desktop:preview": "pnpm --filter @aura/desktop run start",
    "runtime": "pnpm --filter @aura/server run start",
    "build": "pnpm run build:web && pnpm run build:desktop && pnpm run build:mobile && pnpm run build:server",
    "build:web": "pnpm --filter @aura/web run build",
    "build:desktop": "pnpm --filter @aura/desktop run build",
    "build:mobile": "pnpm --filter @aura/mobile run build",
    "build:server": "pnpm --filter @aura/server run build",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "preview": "tsx scripts/run-with-runtime.ts preview",
    "typecheck": "pnpm run typecheck:dev && pnpm -r --if-present run typecheck",
    "typecheck:dev": "tsc --noEmit --project tsconfig.dev.json",
    "test": "pnpm -r --if-present run test && tsx --test tests/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:strict": "node scripts/lint-strict.ts",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:prune": "eslint . --prune-suppressions --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "node scripts/check-format.ts",
    "format:check:strict": "prettier . --check",
    "check:workspaces": "tsx scripts/check-workspaces.ts",
    "check": "pnpm run check:product-plugins && pnpm run format:check && pnpm run lint && pnpm run check:workspaces && pnpm run typecheck && pnpm run test",
    "test:runtime": "tsx scripts/smoke-runtime.ts",
    "build:plugins": "node scripts/build-plugins.ts server && node scripts/build-plugins.ts desktop",
    "setup:product-plugins": "node scripts/setup-product-plugins.ts",
    "build:product-plugins": "node scripts/build-product-plugin.ts site-launcher",
    "check:product-plugins": "pnpm run setup:product-plugins && pnpm run build:product-plugins && tsc --noEmit -p plugins/site-launcher/tsconfig.json && eslint --config plugins/site-launcher/eslint.config.ts plugins/site-launcher --max-warnings 0 && prettier plugins/site-launcher --check && tsx --test plugins/site-launcher/test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.1",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "hono": "4.13.7",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "resedit": "3.1.0",
    "sharp": "0.35.4",
    "three": "0.172.0",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.2.2",
    "@aura/extensions": "workspace:*",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "@aura/protocol": "workspace:*"
  }
}
