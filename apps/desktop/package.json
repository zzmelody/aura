{
  "name": "@aura/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "aura": {
    "kind": "app",
    "platform": "desktop"
  },
  "main": "src/main.ts",
  "scripts": {
    "dev": "pnpm run build:preload && tsx ../../scripts/dev-renderer.ts desktop",
    "start": "pnpm run build && tsx ../../scripts/desktop-bundle.ts .",
    "build": "pnpm run build:renderer && pnpm run build:preload && node ../../scripts/build-plugins.ts desktop",
    "build:preload": "tsx ../../scripts/build-desktop-preload.ts",
    "build:renderer": "tsx ../../scripts/build-renderer.ts desktop",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aura/runtime": "workspace:*",
    "@aura/workbench": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "lucide-react": "1.43.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@google/model-viewer": "4.1.0",
    "three": "0.172.0",
    "@aura/plugin-sdk": "workspace:*",
    "@aura/protocol": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.7.0",
    "typescript": "~5.9.2",
    "vite": "8.2.2"
  },
  "files": [
    "src",
    "dist",
    "dist-host"
  ]
}
