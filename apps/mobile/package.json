{
  "name": "@aura/mobile",
  "version": "0.1.0",
  "private": true,
  "aura": { "kind": "app", "platform": "mobile" },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web",
    "export:native": "expo export --platform android --platform ios --output-dir ../../output/native-bundles",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aura/workbench": "workspace:*",
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/metro-runtime": "57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.20",
    "expo-clipboard": "57.0.1",
    "expo-font": "57.0.3",
    "expo-linear-gradient": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "lucide-react-native": "1.42.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
