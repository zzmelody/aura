{
  "name": "@aura/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "aura": {
    "kind": "app",
    "platform": "mobile"
  },
  "scripts": {
    "dev": "tsx ../../scripts/dev-renderer.ts mobile",
    "build": "tsx ../../scripts/build-renderer.ts mobile",
    "sync": "pnpm run build && cap sync",
    "android": "pnpm run build && cap sync android && cap open android",
    "ios": "pnpm run build && cap sync ios && cap open ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aura/workbench": "workspace:*",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.5.1",
    "lucide-react": "1.43.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@google/model-viewer": "4.1.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "~5.9.2",
    "vite": "8.2.2"
  }
}
