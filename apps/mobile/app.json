{
  "expo": {
    "name": "Aura",
    "slug": "aura-workbench",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aura",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0C0B10",
    "icon": "./assets/icon.png",
    "plugins": ["expo-font", "expo-system-ui", "./plugins/with-preview-http.cjs"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.aura.workbench" },
    "android": {
      "package": "com.aura.workbench",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.VIBRATE"]
    },
    "web": { "bundler": "metro", "favicon": "./assets/favicon.png", "name": "Aura · 个人工作台", "description": "留一点空间，给下一个想法。" }
  }
}
