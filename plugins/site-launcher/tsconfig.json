{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": [
      "../../node_modules/@types",
      "../../packages/frontend/workbench/node_modules/@types"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "client/src/**/*.ts",
    "client/src/**/*.tsx",
    "backend/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["**/dist/**"]
}
